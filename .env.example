# Local development with synthetic data only (assumption A6). The API's defaults already
# match these values; export a variable only to override it.
DATABASE_URL=postgresql://proofskill@127.0.0.1:5433/proofskill
TEST_DATABASE_URL=postgresql://proofskill@127.0.0.1:5433/proofskill_test
CHAIN_RPC_URL=http://127.0.0.1:8545
# Written by `pnpm deploy:local`; relative to api/.
REGISTRY_DEPLOYMENT=../contracts/deployments/localhost.json
# Folder with libpq.dll for the pure-Python psycopg driver on Windows.
PG_BIN='C:\Program Files\PostgreSQL\17\bin'
# FastAPI origin that the web app proxies /api/v1 to (web/next.config.ts).
API_ORIGIN=http://127.0.0.1:8000
# B-02 Supabase Auth holds every account, locally too: API-00 proxies its password sign-in and the
# guards verify its ES256 tokens against the project's JWKS. Fill these in the untracked .env.
# SEED_PASSWORD is the accounts' shared password (12+ characters); never commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SEED_PASSWORD=
# Web app origin; share-link URLs point to its verifier route /v/<shareToken>.
WEB_BASE_URL=http://localhost:3000
# Gemini API key for AI matching (B-04), from Google AI Studio. Put the real key only in the
# untracked .env, never here. Empty switches the AI off: API-07 returns 503 (TC-10).
GEMINI_API_KEY=

# --- Deployed stack: Supabase (B-01) and Base Sepolia (B-03) -------------------------------
# Put these in the untracked .env.testnet (or Vercel environment variables), never here, and run api/ commands
# with: uv run --env-file ../.env --env-file ../.env.testnet ...  Unset locally, where the local
# cluster holds the data and the Hardhat node's unlocked test accounts send the transactions.
# DATABASE_URL=              (Supabase session pooler URI, ending in ?sslmode=require)
# SUPABASE_SERVICE_ROLE_KEY= (secret key; only the seed uses it, to create the Auth users)
# CHAIN_RPC_URL=https://sepolia.base.org
# REGISTRY_DEPLOYMENT=deployments/baseSepolia.json
# REGISTRY_OWNER_KEY=        (deployer, registry owner, platform admin)
# ISSUER_KEY_ISS_001=        (one key per issuer, OD-12 custodial default)
# ISSUER_KEY_ISS_002=
# ETHERSCAN_API_KEY=         (contract verification on Basescan)
